---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/casey-hero.jpg';
---

<section class="hero" id="top">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-lede">
        <div class="hero-headline">
          <h1>
            <span>Casey Hsu's <span class="em">Portfolio</span></span>
            <span class="muted">full-stack developer<span class="dim"> · cms, e-commerce &amp; ai automation tooling.</span></span>
          </h1>
        </div>
        <p>
          I've built <span class="mono-em mono">Shopify</span>, <span class="mono-em mono">HubSpot</span> and <span class="mono-em mono">WordPress</span> sites for small brands since 2022, usually as the only developer. I plan migrations to protect search traffic and automate content work with local LLMs and Claude Code. Contentful certified.
        </p>

        <div class="hero-cta">
          <a href="#work" class="btn primary">
            <span>See My Work</span><span class="k">⏎</span>
          </a>
          <a href="/resume.pdf" class="btn">
            <span>My Resume</span><span class="k">⏎</span>
          </a>
          <a href="#contact" class="btn">
            <span>Contact Me</span><span class="k">⏎</span>
          </a>
        </div>
      </div>

      <div class="hero-photo">
        <div class="hero-photo-body">
          <Image
            class="photo hero-photo-img"
            src={heroPhoto}
            alt="Casey Hsu, full-stack developer"
            width={1200}
            height={1100}
            loading="eager"
            fetchpriority="high"
          />
          <div class="photo-overlay-grad"></div>
          <div class="photo-meta">
            <div class="photo-meta-row mono"><span class="k">NAME</span><span>Casey Hsu</span></div>
            <div class="photo-meta-row mono"><span class="k">ROLE</span><span>Full-Stack Dev · CMS &amp; AI</span></div>
            <div class="photo-meta-row mono"><span class="k">SINCE</span><span>2022</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
