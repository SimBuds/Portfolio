---
import SectionHead from './SectionHead.astro';
import { Image } from 'astro:assets';
import aboutPhoto from '../assets/casey-about.jpg';
import { ABOUT } from '../data/about';
---

<section class="section" id="about">
  <div class="container">
    <SectionHead
      idx="03"
      kicker="about"
      inlineDescr
      descr={ABOUT.descr}/>

    <div class="about-grid">
      <div class="about-photo reveal">
        <div class="about-photo-img">
          <Image class="photo" src={aboutPhoto} alt="Casey Hsu portrait" width={1080} height={1620} />
        </div>
      </div>

      <div class="about-text reveal">
        <h2 set:html={ABOUT.heading}></h2>
        <div class="about-para">
          {ABOUT.paras.map((p) => (
            <p class={p.muted ? 'muted' : undefined} set:html={p.html}></p>
          ))}
        </div>

        <div class="stats-strip">
          {ABOUT.stats.map((s) => (
            <div class="stat">
              <div class="k">{s.k}</div>
              <div class="v">{s.v}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
